# ==============================================================================
# PatchOps - Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Laravel Configuration
# ------------------------------------------------------------------------------
APP_NAME=PatchOps
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://patchops.internal
LOG_CHANNEL=stack
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Primary Database (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=ep-cool-snowflake-123456.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=patchops_production
DB_USERNAME=patchops_app
DB_PASSWORD=your_secure_db_password_here
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# 3. Queue & Cache (Upstash Serverless Redis)
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=sync
CACHE_STORE=file
REDIS_CLIENT=predis
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379
REDIS_SCHEME=tls
REDIS_HOST=your-endpoint.upstash.io
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_upstash_password
REDIS_DB=0
REDIS_CACHE_DB=0

# ------------------------------------------------------------------------------
# 4. Google Gemini LLM Engine
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_MAX_OUTPUT_TOKENS=8192

# ------------------------------------------------------------------------------
# 5. Sandbox MCP Server Connection
# ------------------------------------------------------------------------------
SANDBOX_MCP_HOST=127.0.0.1
SANDBOX_MCP_PORT=8088
SANDBOX_MCP_SECRET=your_mcp_auth_hmac_secret_here
SANDBOX_DEFAULT_TTL_MINUTES=30

# ------------------------------------------------------------------------------
# 6. GitHub Integration (App / Bot)
# ------------------------------------------------------------------------------
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/etc/patchops/secrets/github_app.pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_TOKEN=your_github_pat_or_bot_token_here

# ------------------------------------------------------------------------------
# 7. Security & Redaction Settings
# ------------------------------------------------------------------------------
SECRETS_REDACTION_ENABLED=true
QUALITY_GATE_MAX_ITERATIONS=3
